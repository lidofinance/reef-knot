{
  "name": "@reef-knot/ui-lido",
  "version": "0.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "typesVersions": {
    "*": {
      ".": [
        "dist/index.d.ts"
      ]
    }
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "homepage": "https://github.com/lidofinance/reef-knot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lidofinance/reef-knot.git",
    "directory": "packages/ui-lido"
  },
  "bugs": {
    "url": "https://github.com/lidofinance/reef-knot/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "yarn run -T tsdown",
    "dev": "yarn run -T tsdown --watch",
    "lint": "yarn run -T eslint .",
    "typecheck": "yarn run -T tsc --noEmit",
    "test": "vitest run"
