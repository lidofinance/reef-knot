{
  "name": "reef-knot_root",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/wallets/*",
    "packages/connectors/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build-packages": "turbo run build --filter='./packages/**/*'",
    "build-apps": "turbo run build --filter='./apps/*'",
    "dev": "turbo run dev --concurrency=100",
    "dev-demo-react": "turbo run dev --filter='./apps/demo-react'",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck --continue",
    "check-packages": "turbo run typecheck lint test --filter='./packages/**/*' && yarn check-ui-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "new-wallet": "turbo gen wallet",
    "check-ui-types": "tsc -p tsconfig.ui-tests.json --noEmit"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@lidofinance/multi-semantic-release": "^1.0.2",
    "@turbo/gen": "2.10.12",
    "@types/react": "18.2.45",
    "@types/react-dom": "18.2.17",
    "@types/styled-components": "5.1.12",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-turbo": "2.11.7",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-eslint-comments": "3.2.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "77.0.0",
    "globals": "17.13.0",
    "prettier": "^3.9.6",
    "tsdown": "0.22.14",
    "tslib": "2.8.1",
    "turbo": "latest",
    "typescript": "~5.9",
    "typescript-eslint": "8.71.1"
  },
  "release": {
    "branches": [
      "main",
      {
        "name": "develop",
        "channel": "alpha",
        "prerelease": "alpha"
      }
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      [
        "@semantic-release/github",
        {
          "successComment": false,
          "failComment": false
        }
      ]
    ]
  },
  "multi-release": {
    "sequentialInit": true,
    "deps": {
      "bump": "override",
      "prefix": "",
      "release": "patch"
    }
  },
  "resolutions": {
    "basic-ftp": "^5.3.1",
    "axios": "^1.18.0",
    "js-yaml": "^4.3.1",
    "ws@^7.3.1": "^7.5.13",
    "ws@^7.5.1": "^7.5.13",
    "ws@^7.5.10": "^7.5.13",
    "ws@8.20.1": "^8.21.0",
    "ws@^8.5.0": "^8.21.0",
    "ws@^8.18.3": "^8.21.0",
    "ws@^8.19.0": "^8.21.0",
    "undici@^7.0.0": "^7.29.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "yarn@4.17.1"
}
